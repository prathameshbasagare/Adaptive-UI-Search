# Copy this file to .env.local and fill in your values

# Required (at least one): AI Provider API keys
# The system will use whichever keys are configured and automatically
# fall back between providers if one fails.

# Google Gemini / Gemma API key
# Get your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API key (enables additional free models)
# Get a free key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Pexels API key (enables the image_gallery component)
# Get a free key from https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here
