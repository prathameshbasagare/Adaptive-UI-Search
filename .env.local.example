# Copy this file to .env.local and fill in your values

# Required (at least one): AI Provider API keys
# The system will use whichever keys are configured and automatically
# fall back between providers if one fails.

# Google Gemini / Gemma API key
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API key (enables additional free models)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Pexels API key (enables the image_gallery component)
PEXELS_API_KEY=your_pexels_api_key_here
