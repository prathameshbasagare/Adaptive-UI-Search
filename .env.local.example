# Copy this file to .env.local and fill in your values.
# At least ONE AI provider is required. Providers are tried in this order and
# the app falls back between them automatically:
#   custom endpoint → OpenRouter → Gemini

# Custom OpenAI-compatible API (tried first when configured)
BASE_URL=https://your-api-endpoint.com/v1
API_KEY=your_api_key_here
# Optional: model names on the custom endpoint (comma-separated)
# CUSTOM_MODELS=auto
# Optional: send response_format=json_object (some gateways stop streaming with it)
# CUSTOM_JSON_MODE=false

# OpenRouter API key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Gemini / Gemma API key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Pexels API key (enables the image_gallery component)
PEXELS_API_KEY=your_pexels_api_key_here

# Optional: web search grounding. Exa is primary; Tavily is the fallback when
# Exa errors, runs out of quota or returns nothing. Either one alone also works.
EXA_API_KEY=your_exa_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
# EXA_SEARCH_TYPE=auto
# WEB_SEARCH_NUM_RESULTS=5
# WEB_SEARCH_TIMEOUT_MS=8000

# Optional tuning
# AI_MAX_ATTEMPTS=5
# AI_MODELS_PER_PROVIDER=2
# AI_ATTEMPT_TIMEOUT_MS=90000
# AI_FIRST_TOKEN_TIMEOUT_MS=45000
# CHAT_RATE_LIMIT_PER_MIN=10
# IMAGES_RATE_LIMIT_PER_MIN=30
